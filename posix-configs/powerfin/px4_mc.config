#!/bin/sh
# PX4 commands need the 'px4-' prefix in bash.
# (px4-alias.sh is expected to be in the PATH)
. px4-alias.sh

param select parameters.bson

param set-default SYS_AUTOSTART 4001

param import

if param greater SYS_AUTOCONFIG 0
then
	param reset_all SYS_AUTOSTART SYS_PARAM_VER CAL_* LND_FLIGHT* TC_* COM_FLIGHT*
fi

# Load the airframe defaults selected by SYS_AUTOSTART directly. The generated
# rc.autostart script performs a linear scan through all compiled airframes.
autostart_file=''
# shellcheck disable=SC2231
for f in ${R}etc/init.d/airframes/"$(param show -q SYS_AUTOSTART)"_*
do
	case "${f##*/}" in
		*\.*)
			# Ignore companion files such as <airframe>.post.
			;;
		*)
			autostart_file="$f"
			break
			;;
	esac
done

if [ -e "$autostart_file" ]
then
	# shellcheck disable=SC1090
	. "$autostart_file"
else
	echo "Error: no autostart file found ($autostart_file)"
	exit 1
fi

unset autostart_file
unset f

# system_power not implemented
param set CBRK_SUPPLY_CHK 894281

param set-default BAT1_V_DIV 5.7

# always keep current config
param set SYS_AUTOCONFIG 0
# useless but required for parameter completeness
param set MAV_TYPE 2

param set IMU_GYRO_RATEMAX 800

# Serial port defaults
param set-default MAV_0_CONFIG 0 # MAVLink uses UDP by default
param set-default MSP_OSD_CONFIG 102 # TELEM2 (/dev/ttyS2)
param set-default RC_PORT_CONFIG 103 # TELEM3 (/dev/ttyS3)

# Multi-EKF
param set SENS_IMU_MODE 0
param set BAT1_SOURCE -1


dataman start -f datamanfs
load_mon start

battery_status start


sc7u22_status=/run/powerfin-sc7u22.status
sc7u22_tries=100
while [ ! -r "$sc7u22_status" ] && [ "$sc7u22_tries" -gt 0 ]
do
	sleep 0.01
	sc7u22_tries=$((sc7u22_tries - 1))
done

if [ "$(cat "$sc7u22_status" 2>/dev/null)" != ready ]
then
	echo "Failed to load sc7u22 kernel module"
	exit 1
fi

unset sc7u22_status
unset sc7u22_tries

sc7u22_iio start -R 10
qmc5883p -I -a 0x2c start
spa06 -I -a 0x77 start
atxxxx -s start

# Resolve only the serial ports used by Powerfin. This avoids the generated
# rc.serial script scanning every compiled serial driver and MAVLink instance.
serial_ports_used=''
serial_device='none'
baud_param=''

resolve_serial_port()
{
	serial_config=$(param show -q "$1")
	case "$serial_config" in
		10[1-5])
			serial_index=$((serial_config - 100))
			serial_device="/dev/ttyS$serial_index"
			baud_param="SER_TEL${serial_index}_BAUD"
			;;
		*) serial_device='none'; baud_param='' ;;
	esac

	if [ "$serial_device" != 'none' ]
	then
		case " $serial_ports_used " in
			*" $serial_device "*)
				echo "Conflicting config for $serial_device"
				serial_device='none'
				baud_param=''
				;;
			*) serial_ports_used="$serial_ports_used $serial_device" ;;
		esac
	fi
}

dual_gps_args=''
resolve_serial_port GPS_2_CONFIG
if [ "$serial_device" != 'none' ]
then
	dual_gps_args="-e $serial_device -g p:$baud_param"
fi

resolve_serial_port GPS_1_CONFIG
if [ "$serial_device" != 'none' ]
then
	# dual_gps_args intentionally expands to separate arguments.
	# shellcheck disable=SC2086
	gps start -d "$serial_device" -b "p:$baud_param" $dual_gps_args
fi

resolve_serial_port MSP_OSD_CONFIG
if [ "$serial_device" != 'none' ]
then
	msp_osd start -d "$serial_device"
fi

rc_input_args=''
resolve_serial_port RC_PORT_CONFIG
if [ "$serial_device" != 'none' ]
then
	rc_input_args="-d $serial_device"
fi

if [ -n "$rc_input_args" ]
then
	# rc_input_args intentionally expands to separate arguments.
	# shellcheck disable=SC2086
	if param compare RC_INPUT_PROTO 6
	then
		crsf_rc start $rc_input_args
	else
		rc_input start $rc_input_args
	fi
fi

unset -f resolve_serial_port
unset serial_ports_used
unset serial_config
unset serial_index
unset serial_device
unset baud_param
unset dual_gps_args
unset rc_input_args

rc_update start
sensors start
commander start
navigator start
ekf2 start
land_detector start multicopter
mc_hover_thrust_estimator start
flight_mode_manager start
manual_control start
mc_pos_control start
mc_att_control start
mc_rate_control start

if param greater -s MC_AT_EN 0
then
	mc_autotune_attitude_control start
fi

mavlink start -x -u 14556 -p -n usb0 -r 1152000
mavlink start -x -u 14557 -p -n wlan0 -r 1152000

flexbus_dshot start -d /dev/rk-flexbus-dshot -t
control_allocator start
logger start -t -b 200

mavlink boot_complete

: > /run/powerfin-px4-ready
